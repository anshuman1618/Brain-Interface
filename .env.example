# Copy to .env and fill in. See DEPLOYMENT.md for per-host setup.

# --- API server (artifacts/api-server) ---------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/chamber
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Port the API listens on. Defaults to 5000 when unset.
PORT=5000
# Interface to bind. Defaults to 0.0.0.0 so containers/preview envs can reach it.
HOST=0.0.0.0
# Single-origin hosting: where the built SPA lives. Defaults to
# artifacts/practice-portal/dist/public. Unset + unbuilt => API-only server.
CLIENT_DIST_PATH=
# Comma-separated browser origins allowed to call the API. Leave unset when the
# frontend is served from the same origin as the API. REQUIRED in production
# when they are hosted separately, e.g. https://your-site.netlify.app
CORS_ALLOWED_ORIGINS=
# HMAC key for scoped workspace tokens. SET THIS IN PRODUCTION: unset, the
# server falls back to a random per-process secret, so tokens are invalidated by
# every restart and one replica rejects tokens minted by another. Minimum 16
# characters; generate with `openssl rand -hex 32`.
WORKSPACE_TOKEN_SECRET=
# Set to "off" only when TLS terminates at a proxy that already sends HSTS.
HSTS=
# Set to "off" when the API is NOT behind a proxy, so X-Forwarded-For is
# ignored. Left on, a client could forge that header to dodge rate limits.
TRUST_PROXY=

# --- Uploaded case files -----------------------------------------------------
# Where document bytes are written. Must be on persistent storage and must NOT
# be inside the web root. Defaults to ./.file-storage
FILE_STORAGE_DIR=
# Per-file cap in bytes. Defaults to 25 MB.
MAX_UPLOAD_BYTES=

# --- Outbound email ----------------------------------------------------------
# Unset, reminders and notices are recorded in the mail_outbox table with
# status "suppressed" and never delivered. Set these to actually send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@yourchamber.in

# --- Practice portal (artifacts/practice-portal) ------------------------------
# Inlined at BUILD time by Vite — a redeploy is required after changing these.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Absolute API origin, e.g. https://your-api.onrender.com
# Leave unset for same-origin deployments (requests stay relative + cookie auth).
VITE_API_BASE_URL=
