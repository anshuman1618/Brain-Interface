# Build output and dependencies
node_modules
dist
*.tsbuildinfo
pnpm-lock.yaml

# The local preview database is a real Postgres data directory, not source.
.preview-data

# Generated by orval from lib/api-spec/openapi.yaml. Reformatting these would be
# undone by the next `pnpm --filter @workspace/api-spec run codegen`, so the
# generator's own output stands as-is.
lib/api-zod/src/generated
lib/api-client-react/src/generated
artifacts/mockup-sandbox/src/.generated

# Verbatim prompt/spec dumps — not code.
attached_assets

# Drizzle's migration state. Generated and rewritten by drizzle-kit, which does
# not format to our rules — reformatting them makes format:check fail after the
# next `generate`, and the snapshot chain is validated by the tool, not by us.
lib/db/drizzle/

# The SPA bundle that `cap sync` copies into each native project. Build output,
# gitignored on both platforms already — this is only so `format:check` does not
# try to reformat a minified bundle that is about to be overwritten.
artifacts/mobile-app/android/app/src/main/assets/public
artifacts/mobile-app/ios/App/App/public

# The other two things `cap sync` writes. Both are in Capacitor's own nested
# .gitignore and never committed — but prettier does not read nested .gitignore
# files, so without this any developer who runs `cap sync` and then
# `pnpm run check` gets a formatting failure on output they did not write and
# cannot keep formatted. CI never sees it: a fresh clone has neither file until
# `cap sync` runs.
artifacts/mobile-app/android/app/src/main/assets/capacitor.config.json
artifacts/mobile-app/android/app/src/main/assets/capacitor.plugins.json
artifacts/mobile-app/ios/App/App/capacitor.config.json
artifacts/mobile-app/ios/App/App/config.xml

# Native project scaffolding generated by `cap add`. Gradle wrappers, xcconfig
# and pbxproj follow their platform's conventions, not ours, and Capacitor
# rewrites them on upgrade.
artifacts/mobile-app/android/gradlew
artifacts/mobile-app/android/gradlew.bat
artifacts/mobile-app/ios/App/App.xcodeproj
