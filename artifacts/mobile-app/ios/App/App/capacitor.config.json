{
	"appId": "in.lexpractice.app",
	"appName": "LEX Practice",
	"webDir": "../practice-portal/dist/public",
	"server": {
		"androidScheme": "https",
		"allowNavigation": []
	},
	"android": {
		"allowMixedContent": false
	},
	"ios": {
		"backgroundColor": "#e6ded2",
		"contentInset": "always"
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": false,
			"backgroundColor": "#e6ded2",
			"androidScaleType": "CENTER_CROP"
		},
		"Keyboard": {
			"resize": "native",
			"resizeOnFullScreen": true
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	},
	"packageClassList": [
		"BiometricAuthNative",
		"AppPlugin",
		"CAPBrowserPlugin",
		"CAPCameraPlugin",
		"FilesystemPlugin",
		"KeyboardPlugin",
		"PreferencesPlugin",
		"PushNotificationsPlugin",
		"SharePlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
