<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                The OAuth return path.

                Google refuses to run its consent screen inside an embedded
                webview, so Google and Zoho sign-in leave for a Custom Tab (see
                `allowNavigation` in capacitor.config.ts). This filter is how
                they get back: Clerk redirects to
                in.lexpractice.app://portal/callback, Android hands it to this
                activity, and `appUrlOpen` in lib/native.ts forwards it into the
                router.

                `launchMode="singleTask"` above is what makes the return land in
                the RUNNING app rather than a second copy of it — without it the
                user comes back to a fresh instance with no half-finished
                sign-in to complete.

                The scheme must match APP_URL_SCHEME in platform.ts and Clerk's
                allowed redirect URLs. Email and SMS codes never come through
                here; they complete inside the webview.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="in.lexpractice.app" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Photographing a document straight into a case file. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Push notifications. Android 13+ requires the runtime prompt; the app
        asks for it only when somebody turns notifications on, never at launch,
        because a permission dialog before the user knows what the app does is
        the one most often refused permanently.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Face/fingerprint unlock for the app lock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        Declared optional so the listing is not restricted to handsets with a
        camera or a fingerprint reader. Both features degrade to "unavailable"
        rather than crashing.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
</manifest>
